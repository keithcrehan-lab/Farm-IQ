NODE_ENV=development
PORT=3000

# Postgres + PostGIS connection. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://farmreturn:farmreturn@localhost:5432/farmreturn

# TypeORM auto-sync should stay OFF outside local prototyping — use migrations.
DB_SYNCHRONIZE=false

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# AI assistant. Get a free key at https://aistudio.google.com/apikey — no card
# required. Flash/Flash-Lite are the free-tier models; on the free tier Google
# may use your prompts to improve their products, so switch to a paid key
# before any real farmer data goes through this. Leave blank to disable the
# assistant endpoints (they respond with a clear "not configured" error).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
